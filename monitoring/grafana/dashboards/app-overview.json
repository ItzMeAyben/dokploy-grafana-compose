            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_duration_milliseconds_count{environment=~\"$environment\", job=~\"$service\", http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_duration_milliseconds_count{environment=~\"$environment\", job=~\"$service\"}[$__rate_interval])) * 100",
          "refId": "A",
          "instant": true
        }
      ]
