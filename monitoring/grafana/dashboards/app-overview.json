{
  "uid": "app-overview",
  "title": "App overview",
  "tags": [
    "app"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=~\"thorneai/.+\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values({job=~\"thorneai/.+\"}, environment)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "",
        "sort": 1
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=~\"thorneai/.+\"}, job)",
          "refId": "service"
        },
        "definition": "label_values({job=~\"thorneai/.+\"}, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "HTTP (server)",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{environment=~\"$environment\", job=~\"$service\"}[$__rate_interval])) + (sum(rate(http_server_request_duration_seconds_count{environment=~\"$environment\", job=~\"$service\"}[$__rate_interval])) or vector(0))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
