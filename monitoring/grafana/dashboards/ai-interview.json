        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ai_interview_avatar_session_count_total{environment=~\"$environment\", outcome=\"ready\"}[$__range])) / sum(increase(ai_interview_avatar_session_count_total{environment=~\"$environment\"}[$__range])) * 100",
