        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({job=~\"thorneai/.+\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values({job=~\"thorneai/.+\"}, environment)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "",
        "sort": 1
      }
    ]
  },
