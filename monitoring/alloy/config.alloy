// Every series/stream gets environment=$ENVIRONMENT unless the sender already set one.
// Staging apps pushing here should set environment="staging" (OTLP: deployment.environment=staging).

// Metrics: Prometheus remote_write  ->  Prometheus
prometheus.receive_http "metrics_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9090
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// Host metrics: scrape node_exporter  ->  Prometheus
prometheus.scrape "node_exporter" {
  targets = [
    { __address__ = "node-exporter:9100", instance = "host" },
  ]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "30s"
  job_name        = "node-exporter"
}

// Container metrics: scrape cAdvisor  ->  Prometheus
prometheus.scrape "cadvisor" {
  targets = [
    { __address__ = "cadvisor:8080", instance = "host" },
  ]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "30s"
  job_name        = "cadvisor"
}

// Docker container logs  ->  Loki
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  // ponytail: name-based guess for staging containers on this host; switch to a docker label if names stop matching
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = ".*staging.*"
    target_label  = "environment"
    replacement   = "staging"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.drop_old.receiver]
}

// Loki rejects lines older than 7d; drop them instead of erroring on first backfill
loki.process "drop_old" {
  stage.drop {
    older_than = "168h"
  }
  forward_to = [loki.write.default.receiver]
}

// Logs: Loki push API  ->  Loki
loki.source.api "logs_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  forward_to = [loki.write.default.receiver]
}

// Traces / metrics / logs via OpenTelemetry (OTLP HTTP + gRPC)
otelcol.receiver.otlp "ingest" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.processor.transform.environment.input]
    logs    = [otelcol.processor.transform.environment.input]
  }
}

// OTLP resource deployment.environment -> `environment` label on metrics and logs
otelcol.processor.transform "environment" {
  error_mode = "ignore"

  metric_statements {
    context    = "datapoint"
    statements = [
      `set(attributes["environment"], resource.attributes["deployment.environment"]) where resource.attributes["deployment.environment"] != nil`,
    ]
  }
  log_statements {
    context    = "log"
    statements = [
      `set(attributes["environment"], resource.attributes["deployment.environment"]) where resource.attributes["deployment.environment"] != nil`,
      `set(attributes["loki.attribute.labels"], "environment") where attributes["environment"] != nil`,
    ]
  }

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// =============================================================================
// Exporters (internal fan-out to backends)
// =============================================================================

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
  external_labels = {
    environment = sys.env("ENVIRONMENT"),
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    environment = sys.env("ENVIRONMENT"),
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}
